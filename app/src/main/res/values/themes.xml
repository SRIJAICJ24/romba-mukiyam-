<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base app theme; Compose Material3 draws everything on top of this. -->
    <style name="Theme.RombaMukiyam" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.RombaMukiyam.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.RombaMukiyam</item>
    </style>
</resources>
