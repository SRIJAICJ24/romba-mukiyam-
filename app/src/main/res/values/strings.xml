    <!-- Onboarding -->
    <string name="ob_welcome_title">Welcome to Romba Mukiyam</string>
    <string name="ob_welcome_body">A calm, private place for your family\'s most important logins, cards and documents.</string>
    <string name="ob_local_title">Your vault stays on your device</string>
    <string name="ob_local_point1">Romba Mukiyam does not upload your passwords. There is no account, no cloud and no internet permission.</string>
    <string name="ob_local_point2">Everything is stored in an encrypted database that only your master passphrase (or your fingerprint) can open.</string>
    <string name="ob_local_point3">Your master passphrase is never stored in readable form.</string>
    <string name="ob_local_point4">You decide when to create an encrypted backup file and where to keep it.</string>
    <string name="ob_local_warning_title">Please remember</string>
    <string name="ob_local_warning_body">If you lose your master passphrase AND your recovery key, nobody can open the vault — not even us. There is no back door.</string>
    <string name="ob_pass_title">Create your master passphrase</string>
    <string name="ob_pass_body">A long sentence you can remember works best, for example three or four unrelated words. You will need it whenever fingerprint unlock is unavailable.</string>
    <string name="ob_pass_min">At least %1$d characters</string>
    <string name="ob_confirm_title">Type it once more</string>
    <string name="ob_confirm_body">This makes sure there is no typing mistake in your master passphrase.</string>
    <string name="ob_confirm_mismatch">The passphrases do not match.</string>
    <string name="ob_create_vault">Create my vault</string>
    <string name="ob_generating_title">Building your vault…</string>
    <string name="ob_generating_body">Generating keys and preparing encryption for this device. This can take a few seconds.</string>
    <string name="ob_recovery_title">Your recovery key</string>
    <string name="ob_recovery_body">If you ever forget the master passphrase, this key is the only other way in. Write it down and keep it somewhere physically safe — for example with important family papers.</string>
    <string name="ob_recovery_warning_title">Shown only once</string>
    <string name="ob_recovery_warning_body">Romba Mukiyam cannot show this key again later. You can generate a new one from Settings, but only while you can still unlock the vault.</string>
    <string name="ob_recovery_ack">I have written down my recovery key and stored it safely.</string>
    <string name="ob_bio_title">Unlock with your fingerprint</string>
    <string name="ob_bio_body">For everyday use, your fingerprint opens the vault quickly. Your master passphrase always remains the fallback.</string>
    <string name="ob_bio_enable">Enable fingerprint unlock</string>
    <string name="ob_bio_unavailable_title">Fingerprint not available</string>
    <string name="ob_bio_unavailable_body">This device has no enrolled fingerprint. You can enable fingerprint unlock later from Settings after adding one in your phone settings.</string>
    <string name="ob_profile_title">Who is this vault for?</string>
    <string name="ob_profile_body">Create the first family profile. You can add Mom, Dad, siblings and joint accounts later.</string>
